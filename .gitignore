# Virtual Environments (large, shouldn't be in git)
.venv/
**/.venv/
venv/

# IDE and Editor files
.idea/
.cursor/
.windsurf/
.aider/
.vscode/

# Environment files (may contain secrets)
.env
.env.*
**/.env
**/.env.*

# Python artifacts
__pycache__/
**/__pycache__/
*.pyc
*.pyo
.Python
build/
dist/
*.egg-info/

# Testing and coverage
.coverage
.pytest_cache/
htmlcov/
.tox/

# Logs and temporary files
*.log
*.tmp
*.temp
*.swp
*.swo
*~

# OS-specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db

# Audio recordings and test data
*.wav
*.mp3
*.m4a
recordings/
**/recordings/

# Database files
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite-journal
*.sqlite-wal

# Model and data files
*.bin
*.safetensors
*.ckpt
*.pt
*.pth
models/
**/models/

# Development coordination files
.claude/
.claude-flow/
.swarm/
.hive-mind/
memory/
coordination/
logs/session_*.json

# Keep essential configuration and documentation
!.gitignore
!README.md
!CLAUDE.md
!hypr-voice/
!hypr-voice/**
!whisper/
!whisper/**
!scripts/
!docs/
!docs/**
!tests/
!tests/**
!.gitkeep

# Memory and session structure (keep READMEs)
memory/sessions/*
!memory/sessions/README.md
memory/agents/*
!memory/agents/README.md
coordination/memory_bank/*
coordination/subtasks/*
coordination/orchestration/*