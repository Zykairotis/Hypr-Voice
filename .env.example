# ==============================================================================
# HYPR-VOICE CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your actual API keys and settings
# Most variables have sensible defaults - only set what you need to customize

# ==============================================================================
# 🔑 REQUIRED - API KEYS
# ==============================================================================

# CEREBRAS API - Primary LLM Provider (https://cloud.cerebras.ai)
CEREBRAS_API_KEY_ONE=your_key_here
CEREBRAS_API_KEY_TWO=your_key_here
CEREBRAS_API_KEY_THREE=your_key_here

# WISPR FLOW - Transcription Service (https://wispr-flow.baseten.co)
WISPR_FLOW_JWT_TOKEN=your_jwt_token_here
WISPR_FLOW_BASETEN_API_KEY=your_baseten_key_here
WISPR_FLOW_USER_UUID=your_uuid_here

# ==============================================================================
# 🎤 VOICE TRANSCRIPTION - Core Settings
# ==============================================================================

# Transcription mode: FLOW (cloud API) or LOCAL (hybrid server)
MODE=FLOW

# Wispr Flow API Configuration
WISPR_FLOW_BASETEN_URL=https://chain-o232k03l.api.baseten.co/environments/production/run_remote
WISPR_FLOW_PORT=9095
WISPR_FLOW_TIMEOUT=600

# 🚀 PERFORMANCE OPTIMIZATION
# Chunk size for long recordings (seconds) - larger = faster, fewer API calls
# Default: 30s (use with WISPR_FLOW_CHUNK_SECONDS=27 for streaming mode)
WISPR_FLOW_CHUNK_SECONDS=30

# Audio encoding - Opus is 10x smaller and faster than WAV
WISPR_FLOW_USE_OPUS=1
WISPR_FLOW_OPUS_BITRATE=24k

# Automatic chunking for long audio
WISPR_FLOW_AUTO_CHUNK=1
WISPR_FLOW_CHUNK_OVERLAP=0.5
WISPR_FLOW_MAX_BASE64_MB=50
WISPR_FLOW_MAX_DICTIONARY_WORDS=50

# 🔥 NEW: Streaming Chunking (for 60s+ recordings)
# Automatically enabled - processes chunks while recording
# Set to 0 to disable if you encounter issues
FLOW_STREAMING_MODE=1

# User Info (optional - for personalized context)
WISPR_FLOW_USER_FIRST_NAME=YourName
WISPR_FLOW_USER_LAST_NAME=YourLastName

# ==============================================================================
# 🗣️ TEXT-TO-SPEECH (TTS) - Voice Generation
# ==============================================================================

# TTS Streaming Configuration
HYPR_VOICE_TTS_STREAMING=1
HYPR_VOICE_TTS_REST_STREAMING=1
HYPR_VOICE_TTS_PREBUFFER_MS=800
HYPR_VOICE_TTS_MIN_CHARS=100
HYPR_VOICE_TTS_MAX_LATENCY=0.5
HYPR_VOICE_TTS_FLUSH_TIMEOUT=15
HYPR_VOICE_TTS_IDLE_TIMEOUT=3.0

# TTS Provider API Keys (at least one required)
DEEPGRAM_API_KEY=your_deepgram_key_here
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# ==============================================================================
# 🤖 AI PROVIDERS - Optional / Backup
# ==============================================================================

# Cerebras Configuration
CEREBRAS_PREFERRED_MODELS=gpt-oss-120b,llama-3.3-70b,qwen-3-235b-a22b-thinking-2507
CEREBRAS_TIMEOUT=60
CEREBRAS_MAX_RETRIES=3
CEREBRAS_DEBUG=false

# Anthropic / Claude (via Z.ai proxy)
ANTHROPIC_AUTH_TOKEN=your_z_ai_token_here
ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
ANTHROPIC_DEFAULT_SONNET_MODEL=GLM-4.6

# Google Gemini (optional)
GEMINI_API_KEY=your_gemini_key_here

# CFS Image Generation (optional)
CFS_API_KEY=your_cfs_key_here

# ==============================================================================
# 🌐 BACKEND SERVICES - Internal API Endpoints
# ==============================================================================

NEXT_PUBLIC_BACKEND_URL=http://localhost:8934
NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:9093
NEXT_PUBLIC_HYBRID_URL=http://localhost:9099
NEXT_PUBLIC_CONTEXT_WS=ws://localhost:9091/ws
NEXT_PUBLIC_ORCHESTRATOR_WS=ws://localhost:9093/ws

# ==============================================================================
# 📊 OBSERVABILITY - Event Tracking & Monitoring
# ==============================================================================

CLAUDE_HOOKS_ENABLED=1
CLAUDE_HOOKS_SOURCE_APP=hypr-voice
CLAUDE_HOOKS_OBS_URL=http://localhost:8787
NEXT_PUBLIC_OBS_WS=ws://localhost:8787/ws
NEXT_PUBLIC_OBS_HTTP=http://localhost:8787

# Optional: Hook alerts
CLAUDE_TTS_ALERTS=0
CLAUDE_STATUS_LINE=0

# ==============================================================================
# 🐳 SANDBOX - Code Execution
# ==============================================================================

HYPR_VOICE_E2B_ENABLED=1
HYPR_VOICE_E2B_TEMPLATE=agent-sandbox-dev-node22

# ==============================================================================
# ⏱️ TIMEOUTS & LIMITS
# ==============================================================================

HYPR_AGENT_TIMEOUT=900

# Wispr Flow connection keepalive
WISPR_FLOW_KEEPALIVE_INTERVAL=30
WISPR_FLOW_ASYNC_WARMUP=True
WISPR_FLOW_CHUNK_MODE=1

# ==============================================================================
# 🔍 DEBUGGING & LOGGING
# ==============================================================================

# Enable detailed logging (set to 0 in production)
HYPR_VOICE_TRACE=1
HYPR_VOICE_FLOW_TRACE=1
HYPR_VOICE_TRACE_CONTEXT=1
HYPR_VOICE_TRACE_TCPGEN=1
HYPR_VOICE_TRACE_QUEUE=1

# ==============================================================================
# 📝 NOTES
# ==============================================================================
# 
# QUICKSTART - Minimum Required Variables:
# -----------------------------------------
# 1. CEREBRAS_API_KEY_ONE (for LLM)
# 2. WISPR_FLOW_JWT_TOKEN (for transcription)
# 3. WISPR_FLOW_BASETEN_API_KEY (for transcription)
# 4. WISPR_FLOW_USER_UUID (for transcription)
# 5. DEEPGRAM_API_KEY or ELEVENLABS_API_KEY (for TTS)
#
# Everything else has sensible defaults!
#
# PERFORMANCE TIPS:
# -----------------
# - Keep WISPR_FLOW_USE_OPUS=1 (10x faster uploads)
# - Keep FLOW_STREAMING_MODE=1 (85% faster for long recordings)
# - Increase WISPR_FLOW_CHUNK_SECONDS to 30 for maximum speed
# - Keep WISPR_FLOW_AUTO_CHUNK=1 for automatic optimization
#
# TROUBLESHOOTING:
# ----------------
# - If transcription is slow: Check WISPR_FLOW_USE_OPUS=1
# - If long recordings have delays: Check FLOW_STREAMING_MODE=1
# - If you get errors: Enable HYPR_VOICE_TRACE=1 for detailed logs
#
